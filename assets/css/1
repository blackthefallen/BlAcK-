/* Apply styles to the whole page */
body {
    background-image: url('background.jpg'); /* Replace with your own image */
    background-size: cover;
    background-position: center;
    font-family: Arial, sans-serif;
    color: #fff;
    text-align: center;
    margin: 0;
    padding: 0;
}

/* Style the header */
header {
    background: rgba(0, 0, 0, 0.8);
    padding: 20px;
    border: 2px solid #fff;
    border-radius: 10px;
    margin: 20px;
}

/* Main content box */
main {
    background: rgba(255, 255, 255, 0.8);
    color: black;
    padding: 20px;
    border-radius: 10px;
    border: 2px solid black;
    margin: 20px auto;
    width: 60%;
}

/* Footer */
footer {
    background: rgba(0, 0, 0, 0.8);
    padding: 10px;
    border: 2px solid #fff;
    border-radius: 10px;
    margin: 20px;
}

